{
  "Comment": "A description of my state machine",
  "StartAt": "ResizeImage",
  "States": {
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "arn:aws:lambda:us-east-1:314944603265:function:ResizeImageFunction:$LATEST"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": "$.resizeResult",
      "Next": "Choice"
    },
    "Choice": {
      "Type": "Choice",
      "Choices": [
        {
          "Next": "Success",
          "Variable": "$.resizeResult.Payload.status",
          "StringEquals": "success"
        }
      ],
      "Default": "ImageProcessingFailed"
    },
    "Success": {
      "Type": "Succeed"
    },
    "ImageProcessingFailed": {
      "Type": "Fail",
      "Error": "ImageResizeFailed",
      "Cause": "The image resizing operation was unsuccessful"
    }
  },
  "QueryLanguage": "JSONPath"
}